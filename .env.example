# =============================================================================
# CV Maker — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# docker-compose loads .env automatically via env_file.

# -----------------------------------------------------------------------------
# Authentication (required for production)
# -----------------------------------------------------------------------------

# Google OAuth 2.0 client ID (from Google Cloud Console)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET=your-secret-here

# -----------------------------------------------------------------------------
# AI Providers (at least one recommended)
# -----------------------------------------------------------------------------

# Gemini API key (used for CV parsing and as AI provider)
# GEMINI_API_KEY=AIza...

# Anthropic API key (Claude API provider — alternative to CLI)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI-compatible API key
# OPENAI_API_KEY=sk-proj-...

# -----------------------------------------------------------------------------
# Docker deployment overrides (set automatically by docker-compose.yml)
# -----------------------------------------------------------------------------
# These are set in docker-compose.yml environment section.
# Only uncomment here if running outside Docker or need to override.

# CV_MAKER_DB_PATH=/app/data/cv_maker.db
# BASE_CV_PATH=/app/data/base_cv.yaml
# CORS_ORIGINS=http://localhost
