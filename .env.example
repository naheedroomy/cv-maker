# Required for Claude CLI provider (free with subscription)
# No API key needed — uses your authenticated Claude Code CLI

# Optional: Claude API provider
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Gemini provider
# GEMINI_API_KEY=AIza...

# Optional: OpenAI provider
# OPENAI_API_KEY=sk-proj-...

# Google OAuth 2.0 (required for auth)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# JWT signing secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
# JWT_SECRET=your-secret-here
