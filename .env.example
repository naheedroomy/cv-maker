# =============================================================================
# CV Maker — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# docker-compose loads .env automatically via env_file.

# -----------------------------------------------------------------------------
# Authentication (required for production)
# -----------------------------------------------------------------------------

# Google OAuth 2.0 client ID (from Google Cloud Console)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET=your-secret-here

# -----------------------------------------------------------------------------
# PDF Parsing (server-level — required for CV upload/OCR)
# -----------------------------------------------------------------------------
# This key is used by the server for PDF-to-structured-data parsing.
# It reads directly from this env var — NOT from per-user settings.
# GEMINI_API_KEY=AIza...

# -----------------------------------------------------------------------------
# AI Provider Keys for CV Tailoring — NOT needed here
# -----------------------------------------------------------------------------
# Users set their own API keys via the Settings page in the app.
# Keys are stored per-user in the database.
# Do NOT put ANTHROPIC_API_KEY, OPENAI_API_KEY here — they are user-level.

# -----------------------------------------------------------------------------
# Production overrides
# -----------------------------------------------------------------------------
# On the VPS, set CORS_ORIGINS to your domain:
# CORS_ORIGINS=https://resume.xenohass.work
#
# Defaults to http://localhost if not set.
