# =============================================================================
# CV Maker — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# docker-compose loads .env automatically via env_file.

# -----------------------------------------------------------------------------
# Authentication (required for production)
# -----------------------------------------------------------------------------

# Google OAuth 2.0 client ID (from Google Cloud Console)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET=your-secret-here

# -----------------------------------------------------------------------------
# AI Providers (at least one recommended)
# -----------------------------------------------------------------------------

# Gemini API key (used for CV parsing and as AI provider)
# GEMINI_API_KEY=AIza...

# Anthropic API key (Claude API provider — alternative to CLI)
# In production, this replaces the ~/.claude volume mount used in dev.
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI-compatible API key
# OPENAI_API_KEY=sk-proj-...

# -----------------------------------------------------------------------------
# Docker deployment overrides (set automatically by docker-compose.yml)
# -----------------------------------------------------------------------------
# These are set in docker-compose.yml environment section.
# Only uncomment here if running outside Docker or need to override.

# CV_MAKER_DB_PATH=/app/data/cv_maker.db
# BASE_CV_PATH=/app/data/base_cv.yaml
# CORS_ORIGINS=http://localhost

# -----------------------------------------------------------------------------
# Production Deployment (VPS — docker-compose.prod.yml)
# -----------------------------------------------------------------------------
# On the VPS, create /opt/cv-maker/.env with production values.
# The following are set in docker-compose.prod.yml and should NOT be in .env:
#   CV_MAKER_DB_PATH, BASE_CV_PATH, CORS_ORIGINS
#
# Required in VPS .env:
#   GOOGLE_CLIENT_ID=<your-production-client-id>.apps.googleusercontent.com
#   JWT_SECRET=<generate-a-unique-secret-for-production>
#   GEMINI_API_KEY=<your-gemini-key>
#   ANTHROPIC_API_KEY=<your-anthropic-key>
#
# GitHub Actions secrets (set via gh secret set):
#   VPS_HOST — VPS IP address or hostname
#   VPS_USER — SSH user (e.g., "deploy")
#   SSH_PRIVATE_KEY — ED25519 private key for SSH authentication
#
# GHCR auth on VPS (one-time setup):
#   echo "ghp_YOUR_PAT" | docker login ghcr.io -u naheedroomy --password-stdin
