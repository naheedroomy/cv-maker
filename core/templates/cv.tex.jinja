%# cv.tex.jinja — Jinja2 LaTeX template for TailoredCV
%# Delimiters: \VAR{expr}, \BLOCK{stmt}, %% line-statement, %# line-comment
%# Every user string MUST use the |e filter to escape LaTeX special characters.
\documentclass[11pt,a4paper]{moderncv}
\moderncvstyle{banking}
\moderncvcolor{blue}
\usepackage[scale=0.85]{geometry}
\usepackage{fontspec}
\usepackage{needspace}
\usepackage[dvipsnames]{xcolor}
\usepackage[most]{tcolorbox}

%# Core Competencies pill styling — light teal background, dark text, rounded
\newtcbox{\pill}{
  on line,
  colback=teal!12,
  colframe=teal!12,
  boxrule=0pt,
  arc=4pt,
  boxsep=0pt,
  left=6pt, right=6pt, top=3pt, bottom=3pt,
  fontupper=\small\sffamily
}

%# Contact info
\name{\VAR{cv.contact.name|e}}{}
\email{\VAR{cv.contact.email|e}}
\BLOCK{if cv.contact.phone}
\phone[mobile]{\VAR{cv.contact.phone|e}}
\BLOCK{endif}
\BLOCK{if cv.contact.linkedin}
\social[linkedin]{\VAR{cv.contact.linkedin|e|replace("https://www.linkedin.com/in/", "")|replace("https://linkedin.com/in/", "")|replace("linkedin.com/in/", "")}}
\BLOCK{endif}
\BLOCK{if cv.contact.github}
\social[github]{\VAR{cv.contact.github|e|replace("https://github.com/", "")|replace("github.com/", "")}}
\BLOCK{endif}
\BLOCK{if cv.contact.location}
\address{\VAR{cv.contact.location|e}}{}{}
\BLOCK{endif}
\BLOCK{if cv.contact.work_authorization}
\extrainfo{\VAR{cv.contact.work_authorization|e}}
\BLOCK{endif}

\begin{document}
\makecvtitle

\section{Summary}
\VAR{cv.summary|se}

\BLOCK{if cv.core_competencies}
\bigskip
\section{Core Competencies}
\begin{sloppypar}
\noindent
\BLOCK{for comp in cv.core_competencies}
\pill{\VAR{comp|e}}\hspace{4pt}%
\BLOCK{endfor}
\end{sloppypar}
\BLOCK{endif}

\bigskip
\section{Experience}
\BLOCK{for exp in cv.experience}
\BLOCK{if not loop.first}
\medskip
\BLOCK{endif}
\needspace{5\baselineskip}
\cventry
    {\VAR{exp.start} -- \VAR{exp.end if exp.end else "Present"}}
    {\VAR{exp.title|e}}
    {\VAR{exp.company|e}}
    {\VAR{exp.location|e if exp.location else ""}}
    {}
    {\BLOCK{if exp.bullets}\begin{itemize}
\BLOCK{for bullet in exp.bullets}
        \item \VAR{bullet|be}
\BLOCK{endfor}
    \end{itemize}\BLOCK{endif}}
\BLOCK{endfor}

\BLOCK{if cv.certifications}
\bigskip
\section{Certifications}
\begin{itemize}
\BLOCK{for cert in cv.certifications}
    \item \VAR{cert|e}
\BLOCK{endfor}
\end{itemize}
\BLOCK{endif}

\bigskip
\section{Education}
\BLOCK{for edu in cv.education}
\cventry
    {\VAR{edu.year if edu.year else ""}}
    {\VAR{edu.degree|e}}
    {\VAR{edu.institution|e}}
    {\VAR{edu.field|e if edu.field else ""}}{}{}
\BLOCK{endfor}

\BLOCK{if cv.skills}
\bigskip
\section{Skills}
\BLOCK{for skill in cv.skills}
\BLOCK{if ":" in skill}
\BLOCK{set parts = skill.split(":", 1)}
\textbf{\VAR{parts[0].strip()|e}:} \VAR{parts[1].strip()|e}\BLOCK{if not loop.last}\\[2pt]\BLOCK{endif}
\BLOCK{else}
\VAR{skill|e}\BLOCK{if not loop.last}, \BLOCK{endif}
\BLOCK{endif}
\BLOCK{endfor}
\BLOCK{endif}

\BLOCK{if cv.highlighted_technologies}
\bigskip
\section{Technologies}
\begin{sloppypar}
\noindent
\BLOCK{for tech in cv.highlighted_technologies}
\pill{\VAR{tech|e}}\hspace{4pt}%
\BLOCK{endfor}
\end{sloppypar}
\BLOCK{endif}

\BLOCK{if cv.languages}
\bigskip
\section{Languages}
\BLOCK{for lang in cv.languages}
\cvitem{\VAR{lang.language|e}}{\VAR{lang.level|e}}
\BLOCK{endfor}
\BLOCK{endif}

\BLOCK{if cv.projects}
\bigskip
\section{Projects}
\BLOCK{for proj in cv.projects}
\cvitem{\VAR{proj.name|e}}{\VAR{proj.description|e}%
\BLOCK{if proj.technologies}
 \textit{(\VAR{", ".join(proj.technologies)|e})}%
\BLOCK{endif}
\BLOCK{if proj.url}
 \href{\VAR{proj.url}}{}%
\BLOCK{endif}
}
\BLOCK{endfor}
\BLOCK{endif}

\end{document}
